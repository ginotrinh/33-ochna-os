# OCHNA-K1: OchnaOS overrides on top of config/ubuntu-26.04.config
CONFIG_LOCALVERSION="-ochna"
# OCHNA-K3: Rust support for new drivers
CONFIG_RUST=y
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# OCHNA-K6: BTF on for systemd BPF LSM and eBPF tools
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# OCHNA-K7: compress DWARF in objects to fit the CI runner disk
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y
# OCHNA-K3: MODVERSIONS off so Rust builds without gendwarfksyms
# CONFIG_MODVERSIONS is not set
